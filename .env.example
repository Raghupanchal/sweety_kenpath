# -----------------------------------------------------------------------------
# Sweety – Blood Glucose Tracker Environment Variables
# -----------------------------------------------------------------------------

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sweety_db
DB_USER=postgres
DB_PASSWORD=postgrespassword

# Or full connection URI:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/sweety_db

# JWT Security
JWT_SECRET=replace_with_a_long_cryptographically_secure_random_string
JWT_EXPIRES_IN=7d

# Frontend CORS
CLIENT_ORIGIN=http://localhost:5173

# Frontend (Vite) Variables
VITE_API_URL=http://localhost:5000/api
