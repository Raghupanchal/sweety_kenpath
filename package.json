{
  "name": "sweety-glucose-tracker",
  "version": "1.0.0",
  "description": "Sweety – Blood Glucose Tracker (MERN + PostgreSQL)",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "test": "npm run test:server && npm run test:client",
    "migrate": "npm --prefix server run migrate",
    "seed": "npm --prefix server run seed",
    "build:client": "npm --prefix client run build"
  },
  "keywords": [
    "diabetes",
    "glucose-tracker",
    "react",
    "express",
    "postgresql",
    "tailwind"
  ],
  "author": "Kenpath Candidate",
  "license": "MIT"
}
